{
  "ignore": ["session_db.json", "*.log", "node_modules", ".env", ".git"],
  "watch": [
    "*.js",
    "routes/**/*.js",
    "controllers/**/*.js",
    "models/**/*.js",
    "middleware/**/*.js",
    "bots/**/*.js",
    "config/**/*.js",
    "utils/**/*.js",
    "validators/**/*.js"
  ],
  "ext": "js,json",
  "delay": 1000
}
