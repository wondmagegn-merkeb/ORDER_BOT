<style>
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }

  .spinner {
    border: 2px solid #f3f3f3;
    border-top: 2px solid #fff;
    border-right: 2px solid #fff;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<div class="max-w-xl mx-auto bg-white p-6 dark:bg-gray-800 rounded-lg shadow-md animate-fade-in-up">
  <h2 class="text-3xl font-extrabold mb-6 text-gray-800 dark:text-gray-100 text-center flex items-center justify-center gap-2 transition duration-500">
    <i class="fas fa-edit text-green-600"></i>
    Update Order
  </h2>

  <!-- Order Details Section -->
  <div class="mb-6 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg shadow-sm">
    <h3 class="text-xl font-bold mb-4 text-gray-800 dark:text-gray-100 flex items-center gap-2">
      <i class="fas fa-receipt text-blue-600"></i>
      Order Details
    </h3>
    
    <div class="space-y-2 mb-4">
      <div class="flex justify-between">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Order ID:</span>
        <span class="text-blue-600 dark:text-blue-400"><%= order.orderId %></span>
      </div>
      <div class="flex justify-between">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Status:</span>
        <span class="px-2 py-1 rounded text-sm font-medium <%= order.status === 'pending' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' : order.status === 'progress' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' : order.status === 'completed' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : order.status === 'delivered' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' %>">
          <%= order.status %>
        </span>
      </div>
      <div class="flex justify-between">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Current Total:</span>
        <span class="text-green-600 dark:text-green-400 font-bold"><%= order.totalPrice || order.newTotalPrice %> birr</span>
      </div>
    </div>

    <!-- Items Section -->
    <% if (order.items && Array.isArray(order.items) && order.items.length > 0) { %>
      <div class="mt-4 border-t border-gray-300 dark:border-gray-600 pt-4">
        <h4 class="text-lg font-semibold mb-3 text-gray-800 dark:text-gray-100 flex items-center gap-2">
          <i class="fas fa-shopping-cart text-green-600"></i>
          Items (<%= order.items.length %>)
        </h4>
        <div class="flex flex-wrap gap-3">
          <% order.items.forEach((item, index) => { %>
            <div class="bg-white dark:bg-gray-800 p-3 rounded-lg border border-gray-200 dark:border-gray-600 flex-1 min-w-[calc(50%-0.375rem)]">
              <div class="flex flex-col">
                <div class="font-semibold text-gray-800 dark:text-gray-100 mb-2">
                  <%= index + 1 %>. <%= item.foodName || 'Unknown Item' %>
                </div>
                <div class="text-sm text-gray-600 dark:text-gray-400">
                  Price: <%= item.price %> birr × Quantity: <%= item.quantity %> = <strong class="text-green-600 dark:text-green-400"><%= item.itemTotal || (item.price * item.quantity) %> birr</strong>
                </div>
                <% if (item.specialOrder) { %>
                  <div class="mt-2 text-sm text-blue-600 dark:text-blue-400">
                    <i class="fas fa-sticky-note"></i> Note: <%= item.specialOrder %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } else if (typeof order.items === 'string') { %>
      <% try { const parsedItems = JSON.parse(order.items); %>
        <% if (Array.isArray(parsedItems) && parsedItems.length > 0) { %>
          <div class="mt-4 border-t border-gray-300 dark:border-gray-600 pt-4">
            <h4 class="text-lg font-semibold mb-3 text-gray-800 dark:text-gray-100 flex items-center gap-2">
              <i class="fas fa-shopping-cart text-green-600"></i>
              Items (<%= parsedItems.length %>)
            </h4>
            <div class="flex flex-wrap gap-3">
              <% parsedItems.forEach((item, index) => { %>
                <div class="bg-white dark:bg-gray-800 p-3 rounded-lg border border-gray-200 dark:border-gray-600 flex-1 min-w-[calc(50%-0.375rem)]">
                  <div class="flex flex-col">
                    <div class="font-semibold text-gray-800 dark:text-gray-100 mb-2">
                      <%= index + 1 %>. <%= item.foodName || 'Unknown Item' %>
                    </div>
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                      Price: <%= item.price %> birr × Quantity: <%= item.quantity %> = <strong class="text-green-600 dark:text-green-400"><%= item.itemTotal || (item.price * item.quantity) %> birr</strong>
                    </div>
                    <% if (item.specialOrder) { %>
                      <div class="mt-2 text-sm text-blue-600 dark:text-blue-400">
                        <i class="fas fa-sticky-note"></i> Note: <%= item.specialOrder %>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      <% } catch(e) { %>
        <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">Items data unavailable</div>
      <% } %>
    <% } %>
  </div>

  <form id="orderForm" action="/api/orders/<%= order.orderId %>" method="POST" class="space-y-5">

    <!-- New Total Price -->
    <div class="transition duration-300 transform hover:scale-[1.01]">
      <label class="block mb-1 text-gray-700 dark:text-gray-300 font-medium">New Total Price</label>
      <div class="flex items-center border border-gray-300 dark:border-gray-600 p-2 rounded focus-within:ring-2 focus-within:ring-blue-400">
        <i class="text-gray-400 dark:text-gray-500 mr-2">ETB</i>
        <input 
          type="number" 
          name="newTotalPrice" 
          value="<%= order.totalPrice || '' %>" 
          placeholder="Enter New Total Price"
          class="w-full bg-transparent focus:outline-none text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500" 
          step="0.01"
          min="0"
        >
      </div>
    </div>

    <!-- Order Status Selection -->
    <div class="transition duration-300 transform hover:scale-[1.01]">
      <label class="block mb-1 text-gray-700 dark:text-gray-300 font-medium">Order Status</label>
      <div class="flex items-center border border-gray-300 dark:border-gray-600 p-2 rounded focus-within:ring-2 focus-within:ring-blue-400">
        <i class="fas fa-tasks text-gray-400 dark:text-gray-500 mr-2"></i>
        <select name="status" class="w-full bg-white dark:bg-gray-700 dark:text-gray-200 focus:outline-none">
          <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="progress" <%= order.status === 'progress' ? 'selected' : '' %>>In Progress</option>
          <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
        </select>
      </div>
    </div>

    <!-- Submit and Cancel Buttons -->
    <div class="pt-6 flex justify-between items-center">
      <button type="submit" id="submitButton" class="bg-green-600 dark:bg-green-500 text-white px-6 py-2 rounded flex items-center gap-2 hover:bg-blue-700 transition font-semibold">
        <i class="fas fa-save"></i>
        <span>Update Order</span>
        <div id="spinner" class="spinner hidden"></div>
      </button>

      <a href="/orders" class="text-gray-600 dark:text-gray-300 hover:text-red-500 transition flex items-center gap-2 font-medium">
        <i class="fas fa-times-circle text-red-500"></i>
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('orderForm');
  const submitButton = document.getElementById('submitButton');
  const spinner = document.getElementById('spinner');

  form.addEventListener('submit', function () {
    submitButton.disabled = true;
    spinner.classList.remove('hidden');
  });
</script>
