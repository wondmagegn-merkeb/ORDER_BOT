<header
  class="fixed top-0 left-0 md:left-64 right-0 h-16 bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 shadow flex items-center justify-between px-6 z-30"
>
  <!-- Menu Icon for mobile -->
  <button
    onclick="toggleSidebar()"
    class="md:hidden text-gray-700 dark:text-slate-200 focus:outline-none"
  >
    <svg
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4 6h16M4 12h16M4 18h16"
      />
    </svg>
  </button>

  <!-- Welcome Message (hidden on small screens) -->
  <div
    class="hidden md:block text-gray-800 dark:text-slate-200 text-sm md:text-base font-medium"
  >
    <% if (role === 'admin') { %> Welcome, Admin <% } else if (role ===
    'manager') { %> Welcome, Manager <% } else if (role === 'delivery') { %>
    Welcome, Delivery Man/girl <% } %>
  </div>

  <!-- Clock + Date -->
  <div
    class="text-gray-700 dark:text-slate-300 text-sm md:text-base font-medium mx-4"
    id="datetime"
  ></div>

  <!-- Right-side Tools (Notify + Dark Mode) -->
  <div class="flex items-center gap-3">
    <!-- Notify Me Button (hidden on small screens, shown in sidebar) -->
    <button
      id="notifyButton"
      class="hidden md:block bg-blue-500 dark:bg-blue-600 text-white font-semibold py-1 px-3 rounded hover:bg-blue-600 dark:hover:bg-blue-700 transition text-sm md:text-base"
    >
      <i class="fas fa-bell"></i> Notify Me
    </button>

    <!-- Unsubscribe Button (hidden on small screens, shown in sidebar) -->
    <button
      id="unsubscribeButton"
      class="hidden md:block bg-red-500 dark:bg-red-600 text-white font-semibold py-1 px-3 rounded hover:bg-red-600 dark:hover:bg-red-700 transition text-sm md:text-base"
    >
      <i class="fas fa-bell-slash"></i> Disable
    </button>

    <!-- Dark Mode Toggle Icon -->
    <button
      onclick="toggleDarkMode()"
      class="text-gray-700 dark:text-slate-200 focus:outline-none text-xl"
      id="darkModeToggle"
    >
      <i class="fas fa-moon"></i>
    </button>
  </div>
</header>
